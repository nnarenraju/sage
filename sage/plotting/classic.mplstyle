figure.figsize: 6, 4
figure.dpi: 120
figure.autolayout: True

font.family: sans-serif
font.sans-serif: DejaVu Sans
font.size: 11

axes.grid: True
axes.grid.alpha: 0.2

lines.linewidth: 1.5

legend.frameon: False

axes.prop_cycle: cycler("color", [
    "#4477AA","#EE6677","#228833","#CCBB44",
    "#66CCEE","#AA3377","#BBBBBB"
])

savefig.dpi: 300
savefig.bbox: tight

figure.figsize: 6.2, 4.2
figure.dpi: 140

font.family: serif
font.serif: Computer Modern Roman
font.size: 12
text.usetex: False

axes.linewidth: 1.0
axes.labelsize: 13
axes.titlesize: 14

lines.linewidth: 1.2
lines.markersize: 4

axes.grid: True
axes.grid.alpha: 0.25
axes.grid.linewidth: 0.6

axes.prop_cycle: cycler("color", [
    "#1f77b4", "#ff7f0e", "#2ca02c",
    "#d62728", "#9467bd", "#8c564b"
])

savefig.dpi: 350
savefig.bbox: tight
